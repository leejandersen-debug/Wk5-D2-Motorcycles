---
import BaseLayout from '../layouts/BaseLayout.astro';
import FavoritesList from '../components/FavoritesList.jsx';
import { motorcycles } from '../data/motorcycles.js';
---

<BaseLayout title="Favorites — Motorcycle Finder">
  <section class="listing">
    <a class="back" href="/">
      ← Back to home
    </a>
    <h1>Your favorite bikes</h1>
    <p class="subtitle">
      Saved in this browser. Tap a heart again to remove a bike.
    </p>
    <FavoritesList client:load bikes={motorcycles} />
  </section>
</BaseLayout>

<style>
  .listing {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    color: #475569;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: 1.75rem;
    margin: 0 0 0.5rem;
  }
  .subtitle {
    margin: 0 0 1.5rem;
    color: #64748b;
  }
</style>
