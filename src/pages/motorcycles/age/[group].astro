---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BikeCard from '../../../components/BikeCard.jsx';
import {
  motorcycles,
  ageCategory,
  slugify,
} from '../../../data/motorcycles.js';

export function getStaticPaths() {
  const categories = [...new Set(motorcycles.map(ageCategory))];
  return categories.map((category) => ({
    params: { group: slugify(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const bikes = motorcycles.filter((bike) => ageCategory(bike) === category);
---

<BaseLayout title={`${category} Bikes — Motorcycle Finder`}>
  <section class="listing">
    <a class="back" href="/">
      ← Back to home
    </a>
    <h1>{category} bikes</h1>
    <div class="card-row">
      {bikes.map((bike) => (
        <BikeCard bike={bike} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .listing {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    color: #475569;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: 1.75rem;
    margin: 0 0 1.5rem;
  }
  .card-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .card-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 440px) {
    .card-row {
      grid-template-columns: 1fr;
    }
  }
</style>
