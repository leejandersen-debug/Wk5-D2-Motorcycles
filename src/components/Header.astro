---
const navLinks = [
	{ href: '/motorcycles', label: 'Motorcycles' },
	{ href: '/about', label: 'About' },
];
---

<header class="site-header">
	<div class="header-inner">
		<a class="site-name" href="/">Motorcycle Finder</a>
		<nav>
			<ul>
				{navLinks.map((link) => (
					<li><a href={link.href}>{link.label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid #1e293b;
		background: #10151b;
	}
	.header-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.site-name {
		font-size: 1.25rem;
		font-weight: 700;
		color: #ffffff;
		text-decoration: none;
		letter-spacing: 0.01em;
	}
	nav ul {
		list-style: none;
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
	}
	nav a {
		color: #cbd5e1;
		text-decoration: none;
		font-weight: 500;
	}
	nav a:hover {
		color: #ffffff;
	}
</style>
